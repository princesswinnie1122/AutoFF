    "import json\n",
    "from rdkit import Chem\n",
    "import re\n",
    "\n",
    "# Load the original BB_dic.json file\n",
    "with open('BB_dic.json', 'r') as f:\n",
    "    bb_dic = json.load(f)\n",
    "\n",
    "# Function to convert a single SMILES string\n",
    "def convert_smiles(smiles):\n",
    "    mol_star = Chem.MolFromSmiles(smiles)\n",
    "    if mol_star is None:\n",
    "        print(f\"Warning: Could not process SMILES: {smiles}\")\n",
    "        return smiles  # Return original if processing fails\n",
    "    cans_frag_star = Chem.MolToSmiles(mol_star, isomericSmiles=True, canonical=True)\n",
    "    cans_frag_star = re.sub(r'\\*', '[*]', cans_frag_star)\n",
    "    return cans_frag_star\n",
    "\n",
    "# Process each entry in the dictionary\n",
    "new_bb_dic = {}\n",
    "for bb_name, smiles_list in bb_dic.items():\n",
    "    new_bb_dic[bb_name] = [convert_smiles(smiles) for smiles in smiles_list]\n",
    "\n",
    "# Save the new dictionary to a JSON file\n",
    "with open('BB_dic.json', 'w') as f:\n",
    "    json.dump(new_bb_dic, f, indent=4)\n",
    "\n",
    "print(\"Conversion complete. New file saved as BB_dic_converted.json\")"
   ]
