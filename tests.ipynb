    "import json\n",
    "import re\n",
    "from rdkit import Chem \n",
    "from rdkit.Chem import AllChem as rdkit\n",
    "import stk\n",
    "\n",
    "def clean_para(smiles):\n",
    "    cleaned = re.sub(r'\\(\\)', '', smiles)\n",
    "    cleaned = re.sub(r'=\\)', ')', cleaned)\n",
    "    cleaned = re.sub(r'\\(=', '(', cleaned)\n",
    "    return cleaned\n",
    "\n",
    "smiles = '[*]c1cc([*])nc(C)n1'\n",
    "cleaned = re.sub(r'\\[\\d*\\*\\]', '', smiles)\n",
    "cleaned = clean_para(cleaned)\n",
    "print(cleaned)"
   ]
