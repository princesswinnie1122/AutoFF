    "import json\n",
    "import re\n",
    "\n",
    "# Load the BB_dic.json file\n",
    "with open('BB_dic.json', 'r') as f:\n",
    "    bb_dic = json.load(f)\n",
    "\n",
    "# Function to replace Br, I, F with [*]\n",
    "def replace_halogens_with_brics(smiles):\n",
    "    \"\"\"Replace Br, I, F with [*] in a SMILES string.\"\"\"\n",
    "    return re.sub(r'Br|I|F', '[*]', smiles)\n",
    "\n",
    "# Modify the BB dictionary\n",
    "modified_bb_dic = {}\n",
    "for key, smiles_list in bb_dic.items():\n",
    "    modified_smiles_list = [replace_halogens_with_brics(smiles) for smiles in smiles_list]\n",
    "    modified_bb_dic[key] = modified_smiles_list\n",
    "\n",
    "# Save the modified dictionary to a new JSON file\n",
    "with open('modified_BB_dic.json', 'w') as f:\n",
    "    json.dump(modified_bb_dic, f, indent=4)\n",
    "\n",
    "print(\"Modified BB_dic.json has been created successfully.\")\n"
   ]
