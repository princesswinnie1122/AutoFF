   "source": [
    "BB_dic = {}\n",
    "\n",
    "for molecule_name, molecule_info in data.items():\n",
    "    for BB in data[molecule_name][\"BB\"]:\n",
    "        molecule = molecule_name\n",
    "        smiles = data[molecule][\"smiles\"]\n",
    "        BB_name = BB\n",
    "        #print(BB_name)\n",
    "        if 'Br' in  data[molecule]['BB'][BB_name]:\n",
    "            Br_num = data[molecule]['BB'][BB_name]['Br']\n",
    "\n",
    "        else:\n",
    "            Br_num = None\n",
    "\n",
    "        if 'I' in  data[molecule]['BB'][BB_name]:\n",
    "            I_num = data[molecule]['BB'][BB_name]['I']\n",
    "\n",
    "        else:\n",
    "            I_num = None\n",
    "\n",
    "        if 'F' in  data[molecule]['BB'][BB_name]:\n",
    "            F_num = data[molecule]['BB'][BB_name]['F']\n",
    "\n",
    "        else:\n",
    "            F_num = None\n",
    "\n",
    "        building_block = stk.BuildingBlock(smiles)\n",
    "        mol_rdkit =  building_block.to_rdkit_mol()\n",
    "        atom = list(mol_rdkit.GetAtoms())\n",
    "\n",
    "        for n, a in enumerate(atom):\n",
    "            if Br_num is not None and n+1 in Br_num: #變數\n",
    "                a.SetAtomicNum(35) #Br\n",
    "            if I_num is not None and n+1 in I_num:\n",
    "                a.SetAtomicNum(53) #I \n",
    "            if F_num is not None and n+1 in F_num:\n",
    "                a.SetAtomicNum(9) #F\n",
    "\n",
    "        atom_num = [ a.GetAtomicNum() for a in atom]\n",
    "        atomdic = {}\n",
    "        for n,a in enumerate(atom_num):\n",
    "            if a == 6:\n",
    "                atomdic[str(n+1)] = f'{\"C\"+str(n+1)}'\n",
    "            if a == 1:\n",
    "                atomdic[str(n+1)] = f'{\"H\"+str(n+1)}'\n",
    "            if a == 7:\n",
    "                atomdic[str(n+1)] = f'{\"N\"+str(n+1)}'\n",
    "            if a == 8:\n",
    "                atomdic[str(n+1)] = f'{\"O\"+str(n+1)}'\n",
    "            if a == 16:\n",
    "                atomdic[str(n+1)] = f'{\"S\"+str(n+1)}'\n",
    "\n",
    "        test = stk.BuildingBlock.init_from_rdkit_mol(mol_rdkit)\n",
    "        smiles = Chem.MolToSmiles(mol_rdkit,True)\n",
    "        canonical_smiles = [Chem.MolToSmiles(Chem.MolFromSmiles(smiles,True))]\n",
    "        BB_dic[BB_name] = canonical_smiles\n",
    "        #print(BB_name,canonical_smiles)\n",
    "\n",
    "# 定義JSON文件路徑\n",
    "json_file_path = 'BB_dic.json'\n",
    "\n",
    "# 將字典寫入JSON文件\n",
    "with open(json_file_path, 'w') as json_file:\n",
    "    json.dump(BB_dic, json_file, indent=4)"
   ]
