    "                                                                                                                                                                                                                                                                    import json\n",
    "import sys\n",
    "from rdkit import Chem \n",
    "from rdkit.Chem import AllChem as rdkit\n",
    "import py3Dmol\n",
    "import stk\n",
    "import stko\n",
    "import numpy as np\n",
    "import shutil\n",
    "import os\n",
    "from link import link\n",
    "with open('BB_info.json', 'r') as f:\n",
    "    data = json.load(f)\n",
    "\n"
   ]
  },
